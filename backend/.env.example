# Copy this to backend/.env and fill in your values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_secret_your_secret_key_here
SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
PORT=8000
CORS_ORIGINS=*
# Optional: DB_PASSWORD=your_supabase_db_password

# Reference only: enter these same values in Supabase Dashboard > Authentication > SMTP Settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=DORI

# Google Gemini API Key for AI Fashion Caption and Remix generation
GEMINI_API_KEY=your_gemini_api_key_here
